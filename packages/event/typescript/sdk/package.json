{
  "name": "@perix/event-sdk",
  "version": "0.1.0",
  "description": "Perix TypeScript Event SDK extracted from DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/sdk/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session": {
      "types": "./lib/types/sdk/src/session.d.ts",
      "default": "./lib/session.js"
    },
    "./session/types": {
      "types": "./lib/types/sdk/src/session-types.d.ts",
      "default": "./lib/session-types.js"
    },
    "./session/chunk-rows": {
      "types": "./lib/types/sdk/src/session-chunk-rows.d.ts",
      "default": "./lib/session-chunk-rows.js"
    },
    "./session/surface": {
      "types": "./lib/types/sdk/src/session-surface.d.ts",
      "default": "./lib/session-surface.js"
    },
    "./persistence": {
      "types": "./lib/types/sdk/src/persistence.d.ts",
      "default": "./lib/persistence.js"
    },
    "./persistence-jsonl": {
      "types": "./lib/types/sdk/src/persistence-jsonl.d.ts",
      "default": "./lib/persistence-jsonl.js"
    },
    "./runtime": {
      "types": "./lib/types/sdk/src/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./messages": {
      "types": "./lib/types/sdk/src/messages.d.ts",
      "default": "./lib/messages.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.lib.json && node scripts/rewrite-internal-type-imports.mjs && node scripts/rewrite-public-namespaces.mjs",
    "test": "vitest run --root ../../../.. --config vitest.config.ts packages/event/typescript/tests/sdk"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.3.0",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "license": "MIT"
}
