{
  "name": "@runfold/event",
  "version": "0.1.0",
  "description": "Runfold TypeScript Event SDK extracted from DeepSeek Harness",
  "author": "Heiki Scott",
  "repository": {
    "type": "git",
    "url": "https://github.com/perix-ai/runfold.git",
    "directory": "packages/event/typescript/sdk"
  },
  "homepage": "https://github.com/perix-ai/runfold#readme",
  "bugs": {
    "url": "https://github.com/perix-ai/runfold/issues"
  },
  "keywords": [
    "agent",
    "durable-execution",
    "event-sourcing",
    "trajectory"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/sdk/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session": {
      "types": "./lib/types/sdk/src/session.d.ts",
      "default": "./lib/session.js"
    },
    "./session/types": {
      "types": "./lib/types/sdk/src/session-types.d.ts",
      "default": "./lib/session-types.js"
    },
    "./session/chunk-rows": {
      "types": "./lib/types/sdk/src/session-chunk-rows.d.ts",
      "default": "./lib/session-chunk-rows.js"
    },
    "./session/surface": {
      "types": "./lib/types/sdk/src/session-surface.d.ts",
      "default": "./lib/session-surface.js"
    },
    "./persistence": {
      "types": "./lib/types/sdk/src/persistence.d.ts",
      "default": "./lib/persistence.js"
    },
    "./persistence-jsonl": {
      "types": "./lib/types/sdk/src/persistence-jsonl.d.ts",
      "default": "./lib/persistence-jsonl.js"
    },
    "./runtime": {
      "types": "./lib/types/sdk/src/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./messages": {
      "types": "./lib/types/sdk/src/messages.d.ts",
      "default": "./lib/messages.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.lib.json && node scripts/rewrite-internal-type-imports.mjs",
    "test": "vitest run --root ../../../.. --config vitest.config.ts packages/event/typescript/tests/sdk"
  },
  "dependencies": {
    "@types/node": "^24.3.0",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "license": "MIT"
}
