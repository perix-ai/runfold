+def _run_event_worker(root: Path, session_id: str, mode: str, fork_child: str) -> None:
+    from nexent.core.agents import EventTrajectoryConfig
+    from nexent.core.agents.core_agent import CoreAgent
+    from nexent.core.context_runtime.contracts import ContextEvidence, FinalContext
+    from nexent.core.utils.observer import MessageObserver
+    from smolagents import Tool
+    from smolagents.models import ChatMessage, MessageRole, Model
+    from smolagents.monitoring import TokenUsage
+
+    class AddTool(Tool):
+        name = "add"
+        description = "Add two integers."
+        inputs: ClassVar[dict[str, dict[str, str]]] = {
+            "a": {"type": "integer", "description": "First integer"},
+            "b": {"type": "integer", "description": "Second integer"},
+        }
+        output_type = "integer"
+
+        def forward(self, a: int, b: int) -> int:
+            return a + b
+
+    class ScriptedModel(Model):
+        model_factory = "nexent-acceptance"
+
+        def __init__(self) -> None:
+            super().__init__(model_id="deterministic-event-model")
+
+        def generate(self, _messages, **_kwargs) -> ChatMessage:
+            if mode == "tool":
+                content = "<code>value = add(a=2, b=3)\nfinal_answer(value)</code>"
+            elif mode == "answer":
+                content = "The result remains five."
+            else:
+                content = "The fork continued independently."
+            return ChatMessage(
+                role=MessageRole.ASSISTANT,
+                content=content,
+                token_usage=TokenUsage(input_tokens=10, output_tokens=8),
+            )
+
+    class DeterministicContextRuntime:
+        context_manager = None
+        chars_per_token = 4
+        token_threshold = None
+        context_window_tokens = 8192
+        hard_input_budget_tokens = 4096
+        processing_mode = "passthrough"
+
+        def replace_items(self, _items) -> None:
+            return None
+
+        def prepare_run(self, **_kwargs) -> None:
+            return None
+
+        def prepare_step(self, **_kwargs) -> FinalContext:
+            return FinalContext(
+                messages=[{"role": "user", "content": f"acceptance mode: {mode}"}],
+                evidence=ContextEvidence(),
+            )
+
+        def prepare_final_answer(self, **_kwargs) -> FinalContext:
+            return FinalContext(
+                messages=[{"role": "user", "content": "summarize"}],
+                evidence=ContextEvidence(purpose="final_answer"),
+            )
+
+        def render_summary_messages(self, **_kwargs) -> list:
+            return []
+
+        def finalize_evidence(self, *, status: str) -> ContextEvidence:
+            return ContextEvidence(loop_status=status)
+
+        def compression_stats(self) -> dict:
+            return {
+                "calls": 0,
+                "input_tokens": 0,
+                "output_tokens": 0,
+                "cache_hits": 0,
+                "cache_types": [],
+            }
+
+        def global_compression_stats(self) -> dict:
+            return {"calls": 0, "records": []}
+
+        def token_counts(self) -> dict:
+            return {"uncompressed": None, "compressed": None}
+
+        def consume_history_summary_event(self):
+            return None
+
+    event_package = Path(perix_event.__file__).resolve()
+    if "site-packages" not in event_package.parts:
+        raise RuntimeError(f"Event package is not installed: {event_package}")
+    trajectory = EventTrajectory.open(
+        EventTrajectoryConfig(
+            root=str(root),
+            session_id=session_id,
+            cwd=str(root),
+            compression="none",
+        )
+    )
+    try:
+        agent = CoreAgent(
+            observer=MessageObserver(),
+            tools=[AddTool()],
+            model=ScriptedModel(),
+            context_runtime=DeterministicContextRuntime(),
+            event_trajectory=trajectory,
+            max_steps=2,
+        )
+        prompt = {
+            "tool": "Add two and three.",
+            "answer": "Confirm the result.",
+            "child": "Continue from the fork.",
+        }[mode]
+        output = agent.run(
+            f"[Current time: 2026-09-02 00:00:00]\n\n{prompt}",
+            stream=False,
+        )
+        if fork_child != "-":
+            child = trajectory.store.fork(
+                trajectory.session,
+                child_session_id=fork_child,
+            )
+            trajectory.store.flush(child)
+    finally:
+        trajectory.close()
+    print(
+        "R33_RESULT="
+        + json.dumps(
+            {"output": output, "eventPackage": str(event_package)},
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+    )
+
+
+if __name__ == "__main__" and len(sys.argv) == 6 and sys.argv[1] == "--event-worker":
+    _run_event_worker(
+        Path(sys.argv[2]),
+        sys.argv[3],
+        sys.argv[4],
+        sys.argv[5],
+    )
