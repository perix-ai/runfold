+def test_invalid_event_and_open_turn_fork_do_not_create_false_history(
+    tmp_path: Path,
+) -> None:
+    trajectory = EventTrajectory.open(config(tmp_path))
+    before = trajectory.session.events
+    with pytest.raises(EventValidationError):
+        trajectory.session.append("turn/start", {"turn": math.nan})
+    assert trajectory.session.events == before
+
+    trajectory.begin_turn("still running")
+    boundary = trajectory.session.events[-1]["seq"]
+    with pytest.raises(SessionForkError) as raised:
+        trajectory.store.fork(
+            trajectory.session,
+            boundary=boundary,
+            child_session_id="invalid-child",
+        )
+    assert raised.value.code == "OPEN_TURN"
+    assert all(session.id != "invalid-child" for session in trajectory.store.list())
+    trajectory.close()
+
+
+def test_lock_exception_type_is_public_and_specific() -> None:
+    assert issubclass(EventTrajectoryAlreadyActiveError, RuntimeError)
