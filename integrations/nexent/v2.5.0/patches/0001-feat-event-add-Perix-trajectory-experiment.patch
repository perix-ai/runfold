+class EventTrajectoryConfig(BaseModel):
+    """Stable storage identity for optional Perix Event trajectory recording."""
+
+    root: str = Field(description="Persistent Event artifact root")
+    session_id: str = Field(description="Stable Event session id")
+    cwd: str = Field(description="Stable absolute project path recorded in the Session header")
+    compression: Literal["none", "zstd"] = Field(default="none")
+
+    @model_validator(mode="after")
+    def _validate_stable_identity(self) -> "EventTrajectoryConfig":
+        if not self.root.strip():
+            raise ValueError("Event trajectory root must not be empty")
+        if not os.path.isabs(self.root):
+            raise ValueError("Event trajectory root must be an absolute path")
+        if not self.session_id.strip():
+            raise ValueError("Event trajectory session_id must not be empty")
+        if not os.path.isabs(self.cwd):
+            raise ValueError("Event trajectory cwd must be an absolute path")
+        return self
+
+
