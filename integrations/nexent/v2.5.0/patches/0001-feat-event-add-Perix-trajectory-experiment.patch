+) -> None:
+    script = """
+import os
+import sys
+from types import SimpleNamespace
+from nexent.core.agents.event_trajectory import EventTrajectory
+
+config = SimpleNamespace(root=sys.argv[1], session_id='crash', cwd=sys.argv[1], compression='none')
+trajectory = EventTrajectory.open(config)
+trajectory.begin_turn('run a tool')
+trajectory.begin_step(1)
+trajectory.record_request(provider='test', model='nexent-model')
+original_flush = trajectory.store.flush
+
+def crash_on_boundary(session):
+    original_flush(session)
+    if session.events[-1]['type'] == sys.argv[2]:
+        os._exit(0)
+
+trajectory.store.flush = crash_on_boundary
+trajectory.start_root_tool(
+    model_output='run',
+    name='python_interpreter',
+    arguments='read_file()',
+)
+raise SystemExit(7)
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script, str(tmp_path.resolve()), crash_after],
+        check=False,
+        capture_output=True,
+        text=True,
