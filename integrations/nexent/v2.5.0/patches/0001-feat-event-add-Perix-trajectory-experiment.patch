+"""Direct Perix Event trajectory recording for one Nexent agent run."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import threading
+import uuid
+from pathlib import Path
+from typing import Any, Mapping
+
+
+class EventTrajectoryError(RuntimeError):
+    """Raised when Nexent cannot preserve the Event trajectory contract."""
+
+
+class EventTrajectoryAlreadyActiveError(EventTrajectoryError):
+    """Raised when another process owns the same Event session."""
+
+
+class _SessionLease:
+    """Hold the caller-side single-writer guarantee required by Event v0."""
+
+    def __init__(self, root: str, session_id: str) -> None:
+        try:
+            import fcntl
+        except ImportError as exc:  # pragma: no cover - Nexent production is POSIX.
+            raise EventTrajectoryError("Event trajectories require a POSIX advisory-lock implementation") from exc
+
+        lock_root = Path(root).expanduser().resolve() / ".nexent-event-locks"
+        lock_root.mkdir(parents=True, exist_ok=True)
+        digest = hashlib.sha256(session_id.encode("utf-8")).hexdigest()
+        self.path = lock_root / f"{digest}.lock"
+        self._fcntl = fcntl
+        self._handle = self.path.open("a+b")
+        try:
+            fcntl.flock(self._handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            self._handle.close()
+            raise EventTrajectoryAlreadyActiveError(
+                f'Event session "{session_id}" already has an active writer'
+            ) from exc
+        self._handle.seek(0)
+        self._handle.truncate()
+        self._handle.write(f"{os.getpid()}\n".encode("ascii"))
+        self._handle.flush()
+
+    def close(self) -> None:
+        if self._handle.closed:
+            return
+        try:
+            self._fcntl.flock(self._handle.fileno(), self._fcntl.LOCK_UN)
+        finally:
+            self._handle.close()
+
+
+def _text(value: Any) -> str:
+    if isinstance(value, str):
+        return value
+    try:
+        return json.dumps(
+            value,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        )
+    except (TypeError, ValueError):
+        return str(value)
+
+
+def _json_value(value: Any) -> Any:
+    try:
+        return json.loads(json.dumps(value, ensure_ascii=False, allow_nan=False, default=str))
+    except (TypeError, ValueError):
+        return str(value)
+
+
+def _usage(token_usage: Any) -> dict[str, int] | None:
+    if token_usage is None:
+        return None
+    result: dict[str, int] = {}
+    for source, target in (
+        ("input_tokens", "inputTokens"),
+        ("output_tokens", "outputTokens"),
+    ):
+        value = getattr(token_usage, source, None)
+        if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
+            result[target] = value
+    return result or None
+
+
+class EventTrajectory:
+    """Map real Nexent execution boundaries onto one durable Event v0 session."""
+
+    def __init__(self, store: Any, session: Any, lease: _SessionLease) -> None:
+        from perix_event import (
+            canonical_header,
+            create_assistant_message,
+            create_tool_result_message,
+            create_user_message,
+            header_equals,
+        )
+
+        self.store = store
+        self.session = session
+        self._lease = lease
+        self._canonical_header = canonical_header
+        self._create_assistant_message = create_assistant_message
+        self._create_tool_result_message = create_tool_result_message
+        self._create_user_message = create_user_message
+        self._header_equals = header_equals
+        self._lock = threading.RLock()
+        self._turn: int | None = None
+        self._step: int | None = None
+        self._root_call_id: str | None = None
+        self._root_call_seq: int | None = None
+        self._dispatches: dict[str, tuple[str, Any]] = {}
+        self._turn_header_written = False
+        self._resumed_pending = bool(getattr(session, "first_live_seq", 0))
+        self._provider = "unknown"
+        self._model = "unknown"
+        self._closed = False
+
+    @classmethod
+    def open(cls, config: Any) -> "EventTrajectory":
+        """Acquire one writer and create or resume the configured session."""
+
+        try:
+            from perix_event import (
+                JsonlSessionPersistence,
+                SessionNotFoundError,
+                SessionStore,
+            )
+        except ImportError as exc:
+            raise EventTrajectoryError("Event trajectory support requires the perix-event-sdk package") from exc
+
+        root = str(config.root)
+        session_id = str(config.session_id)
+        configured_cwd = str(config.cwd)
+        lease = _SessionLease(root, session_id)
+        try:
+            persistence = JsonlSessionPersistence(
+                root,
+                compression=str(config.compression),
+            )
+            store = SessionStore(persistence)
+            try:
+                saved = persistence.inspect(session_id)
+            except SessionNotFoundError:
+                session = store.create(session_id, meta={"cwd": configured_cwd})
+            else:
+                saved_cwd = saved.meta.get("cwd")
+                if saved_cwd != configured_cwd:
+                    raise EventTrajectoryError(
+                        f'Event session "{session_id}" belongs to cwd {saved_cwd!r}, not {configured_cwd!r}'
+                    )
+                session = store.resume(session_id)
+            return cls(store, session, lease)
+        except BaseException:
+            lease.close()
+            raise
+
+    @property
+    def active_root_call_id(self) -> str | None:
+        return self._root_call_id
+
+    @property
+    def can_end_turn(self) -> bool:
+        return self._turn is not None and self._step is None
+
+    @property
+    def can_end_step(self) -> bool:
+        return self._step is not None and self._root_call_id is None and not self._dispatches
+
+    def _append(self, event_type: str, data: Any, **options: Any) -> dict[str, Any]:
+        event = self.session.append(event_type, data, **options)
+        self.store.flush(self.session)
+        return event
+
+    def begin_turn(self, query: str) -> int:
+        with self._lock:
+            if self._turn is not None:
+                raise EventTrajectoryError("cannot begin an Event turn while another is open")
+            turns = [
+                event["data"]["turn"]
+                for event in self.session.events
+                if event["type"] == "turn/start" and isinstance(event.get("data", {}).get("turn"), int)
+            ]
+            self._turn = max(turns, default=0) + 1
+            self._turn_header_written = False
+            self._append("turn/start", {"turn": self._turn})
+            message = self._create_user_message(
+                content=[{"type": "text", "text": str(query)}],
+                source={"kind": "user"},
+            )
+            self._append("user/message", message, surface_op="append")
+            return self._turn
+
+    def begin_step(self, step: int) -> None:
+        with self._lock:
+            if self._turn is None:
+                raise EventTrajectoryError("cannot begin an Event step outside a turn")
+            if self._step is not None:
+                raise EventTrajectoryError("cannot begin an Event step while another is open")
+            if not isinstance(step, int) or isinstance(step, bool) or step < 1:
+                raise EventTrajectoryError(f"invalid Nexent step number: {step!r}")
+            self._step = step
+            self._append("step/start", {"turn": self._turn, "step": step})
+
+    def record_request(self, *, provider: str, model: str, system: str = "") -> None:
+        with self._lock:
+            self._require_step()
+            provider = str(provider or "unknown")
+            model = str(model or "unknown")
+            header: dict[str, Any] = {"config": {"provider": provider, "model": model}}
+            if system:
+                header["system"] = str(system)
+            header = self._canonical_header(header)
+            previous = self.session.request_header()
+            if previous is None:
+                reason = "initial"
+            elif self._resumed_pending:
+                reason = "resume"
+            elif not self._header_equals(previous, header):
+                reason = "change"
+            elif self._turn_header_written:
+                self._provider = provider
+                self._model = model
+                return
+            else:
+                reason = "series"
+            data: dict[str, Any] = {"reason": reason, "header": header}
+            if reason == "change":
+                data["startsSeries"] = True
+            self._append("request/header", data)
+            self._provider = provider
+            self._model = model
+            self._turn_header_written = True
+            self._resumed_pending = False
+
+    def record_assistant_text(self, text: Any, token_usage: Any = None) -> None:
+        with self._lock:
+            turn, step = self._require_step()
+            message = self._create_assistant_message(
+                content=[{"type": "text", "text": _text(text)}],
+                source={"provider": self._provider, "model": self._model},
+            )
+            data: dict[str, Any] = {"turn": turn, "step": step, "message": message}
+            usage = _usage(token_usage)
+            if usage is not None:
+                data["usage"] = usage
+            self._append(
+                "assistant/message",
+                data,
+                surface_op="append",
+                source_event_seqs=[],
+            )
+
+    def start_root_tool(
+        self,
+        *,
+        model_output: Any,
+        name: str,
+        arguments: Any,
+        token_usage: Any = None,
+    ) -> str:
+        with self._lock:
+            turn, step = self._require_step()
+            if self._root_call_id is not None:
+                raise EventTrajectoryError("cannot start a second root tool call")
+            call_id = str(uuid.uuid4())
+            arguments_text = _text(arguments)
+            content: list[dict[str, Any]] = []
+            if model_output is not None and str(model_output):
+                content.append({"type": "text", "text": _text(model_output)})
+            content.append(
+                {
+                    "type": "tool-call",
+                    "id": call_id,
+                    "name": str(name),
+                    "arguments": arguments_text,
+                }
+            )
+            message = self._create_assistant_message(
+                content=content,
+                source={"provider": self._provider, "model": self._model},
+            )
+            data: dict[str, Any] = {"turn": turn, "step": step, "message": message}
+            usage = _usage(token_usage)
+            if usage is not None:
+                data["usage"] = usage
+            self._root_call_id = call_id
+            self._append(
+                "assistant/message",
+                data,
+                surface_op="append",
+                source_event_seqs=[],
+            )
+            call = self._append(
+                "tool/call",
+                {
+                    "turn": turn,
+                    "step": step,
+                    "callId": call_id,
+                    "name": str(name),
+                    "arguments": arguments_text,
+                },
+            )
+            self._root_call_seq = call["seq"]
+            return call_id
+
+    def finish_root_tool(self, result: Any, *, is_error: bool, error: BaseException | None = None) -> None:
+        with self._lock:
+            turn, step = self._require_step()
+            if self._root_call_id is None or self._root_call_seq is None:
+                raise EventTrajectoryError("cannot finish a root tool call that is not open")
+            if self._dispatches:
+                raise EventTrajectoryError("cannot finish a root tool while child calls are open")
+            call_id = self._root_call_id
+            message = self._create_tool_result_message(
+                call_id=call_id,
+                content=[{"type": "text", "text": _text(result)}],
+                is_error=is_error,
+            )
+            data: dict[str, Any] = {"turn": turn, "step": step, "message": message}
+            if error is not None:
+                data["error"] = {"name": type(error).__name__, "code": "UNKNOWN"}
+            self._append(
+                "tool/result",
+                data,
+                surface_op="append",
+                source_event_seqs=[self._root_call_seq],
+            )
+            self._root_call_id = None
+            self._root_call_seq = None
+
+    def start_dispatch(self, name: str, arguments: Mapping[str, Any]) -> str:
+        with self._lock:
+            if self._root_call_id is None:
+                raise EventTrajectoryError("cannot record a child tool outside a root call")
+            sub_call_id = str(uuid.uuid4())
+            normalized = _json_value(dict(arguments))
+            self._dispatches[sub_call_id] = (str(name), normalized)
+            self._append(
+                "tool/code-dispatch-start",
+                {
+                    "rootCallId": self._root_call_id,
+                    "parentCallId": self._root_call_id,
+                    "subCallId": sub_call_id,
+                    "name": str(name),
+                    "arguments": normalized,
+                },
+            )
+            return sub_call_id
+
+    def finish_dispatch(self, sub_call_id: str, result: Any, *, is_error: bool) -> None:
+        with self._lock:
+            if self._root_call_id is None or sub_call_id not in self._dispatches:
+                raise EventTrajectoryError("cannot finish a child tool call that is not open")
+            name, arguments = self._dispatches[sub_call_id]
+            self._append(
+                "tool/code-dispatch",
+                {
+                    "rootCallId": self._root_call_id,
+                    "parentCallId": self._root_call_id,
+                    "subCallId": sub_call_id,
+                    "name": name,
+                    "arguments": arguments,
+                    "isError": bool(is_error),
+                    "content": [{"type": "text", "text": _text(result)}],
+                },
+            )
+            del self._dispatches[sub_call_id]
+
+    def end_step(self) -> None:
+        with self._lock:
+            turn, step = self._require_step()
+            if self._root_call_id is not None or self._dispatches:
+                raise EventTrajectoryError("cannot close an Event step while tool calls are open")
+            self._append("step/end", {"turn": turn, "step": step})
+            self._step = None
+
+    def end_turn(self, reason: Mapping[str, Any]) -> None:
+        with self._lock:
+            if self._turn is None:
+                return
+            if self._step is not None:
+                raise EventTrajectoryError("cannot close an Event turn while a step is open")
+            turn = self._turn
+            self._append("turn/end", {"turn": turn, "reason": dict(reason)})
+            self._turn = None
+
+    def _require_step(self) -> tuple[int, int]:
+        if self._turn is None or self._step is None:
+            raise EventTrajectoryError("an Event turn and step must be open")
+        return self._turn, self._step
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            self.store.close()
+        finally:
+            self._lease.close()
