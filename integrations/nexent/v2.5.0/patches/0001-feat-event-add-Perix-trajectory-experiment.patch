+        [sys.executable, "-c", script, str(tmp_path.resolve())],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr
+
+    parent = inspection(tmp_path)
+    child = inspection(tmp_path, "nexent-child")
+    assert list(parent.events[: len(prefix)]) == prefix
+    assert [event["seq"] for event in parent.events] == list(range(len(parent.events)))
+    assert [event["type"] for event in parent.events].count("session/end-seed") == 1
+    assert child.meta["parentSession"] == "nexent-session"
+    assert child.meta["seedLength"] == len(parent.events)
+    assert child.meta["cwd"] == str(tmp_path.resolve())
+    assert list(child.events[: child.meta["seedLength"]]) == list(parent.events)
+
+
+def test_real_core_agent_records_resumes_and_forks_with_installed_event_package(
+    tmp_path: Path,
+) -> None:
+    package_path = Path(perix_event.__file__).resolve()
+    assert "site-packages" in package_path.parts
+
+    first_result = run_real_nexent_process(
+        tmp_path,
+        "nexent-real",
+        "tool",
+    )
+    assert first_result["output"] == 5
+    assert Path(first_result["eventPackage"]) == package_path
+    first = inspection(tmp_path, "nexent-real")
+    first_prefix = list(first.events)
+
+    second_result = run_real_nexent_process(
+        tmp_path,
+        "nexent-real",
+        "answer",
+        "nexent-real-fork",
+    )
+    assert second_result["output"] == "The result remains five."
+    parent = inspection(tmp_path, "nexent-real")
+    assert list(parent.events[: len(first_prefix)]) == first_prefix
+    assert parent.events[len(first_prefix)]["type"] == "session/end-seed"
+    assert [event["seq"] for event in parent.events] == list(range(len(parent.events)))
+
+    child_before = inspection(tmp_path, "nexent-real-fork")
+    assert child_before.meta["parentSession"] == "nexent-real"
+    assert child_before.meta["seedLength"] == len(parent.events)
+    assert child_before.meta["cwd"] == str(tmp_path.resolve())
+    assert list(child_before.events[: len(parent.events)]) == list(parent.events)
+
+    parent_before_child_resume = list(parent.events)
+    child_result = run_real_nexent_process(
+        tmp_path,
+        "nexent-real-fork",
+        "child",
+    )
+    assert child_result["output"] == "The fork continued independently."
+    assert (
+        list(inspection(tmp_path, "nexent-real").events) == parent_before_child_resume
+    )
+
+    child = inspection(tmp_path, "nexent-real-fork")
+    assert [event["seq"] for event in child.events] == list(range(len(child.events)))
+    assert list(child.events[: child.meta["seedLength"]]) == list(parent.events)
+    root_calls = [event for event in parent.events if event["type"] == "tool/call"]
+    dispatches = [
+        event["data"]
+        for event in parent.events
+        if event["type"] == "tool/code-dispatch"
+    ]
+    assert len(root_calls) == 1
+    assert {dispatch["name"] for dispatch in dispatches} == {"add", "final_answer"}
+    assert all(
+        dispatch["rootCallId"] == root_calls[0]["data"]["callId"]
+        for dispatch in dispatches
+    )
+    assert [
+        event["data"]["reason"]
+        for event in parent.events
+        if event["type"] == "request/header"
+    ] == [
+        "initial",
+        "resume",
+    ]
+
