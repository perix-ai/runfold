+    EventTrajectory,
+    EventTrajectoryAlreadyActiveError,
+    EventTrajectoryError,
+)
+
+perix_event = pytest.importorskip(
+    "perix_event",
+    reason="install the Nexent event extra to run Event trajectory tests",
+)
+TOOL_NOT_STARTED = perix_event.TOOL_NOT_STARTED
+TOOL_OUTCOME_UNKNOWN = perix_event.TOOL_OUTCOME_UNKNOWN
+EventValidationError = perix_event.EventValidationError
+JsonlSessionPersistence = perix_event.JsonlSessionPersistence
+SessionForkError = perix_event.SessionForkError
+
+
+def config(root: Path, session_id: str = "nexent-session") -> SimpleNamespace:
+    return SimpleNamespace(
+        root=str(root),
+        session_id=session_id,
+        cwd=str(root.resolve()),
+        compression="none",
+    )
+
+
+def close_direct_answer(trajectory: EventTrajectory, text: str, step: int = 1) -> None:
+    trajectory.begin_turn(text)
+    trajectory.begin_step(step)
+    trajectory.record_request(
+        provider="test", model="nexent-model", system="Be useful."
+    )
+    trajectory.record_assistant_text(f"answer: {text}")
+    trajectory.end_step()
+    trajectory.end_turn({"kind": "completed"})
+
+
+def inspection(root: Path, session_id: str = "nexent-session"):
+    return JsonlSessionPersistence(root, compression="none").load(session_id)
+
+
+def run_real_nexent_process(
+    root: Path,
+    session_id: str,
+    mode: str,
+    fork_child: str = "-",
+) -> dict:
+    env = {key: value for key, value in os.environ.items() if key != "PYTHONPATH"}
+    result = subprocess.run(
+        [
+            sys.executable,
+            str(Path(__file__).resolve()),
+            "--event-worker",
+            str(root.resolve()),
+            session_id,
+            mode,
+            fork_child,
+        ],
+        cwd=root,
+        env=env,
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr or result.stdout
+    marker = "R33_RESULT="
+    line = next(
+        (
+            line
+            for line in reversed(result.stdout.splitlines())
+            if line.startswith(marker)
+        ),
+        None,
+    )
+    assert line is not None, result.stdout
+    return json.loads(line[len(marker) :])
+
+
+def test_records_complete_root_and_real_child_tool_boundaries(tmp_path: Path) -> None:
+    trajectory = EventTrajectory.open(config(tmp_path))
+    trajectory.begin_turn("Inspect README.md")
+    trajectory.begin_step(1)
+    trajectory.record_request(
+        provider="test", model="nexent-model", system="Be useful."
+    )
+    root_call_id = trajectory.start_root_tool(
+        model_output="I will inspect the file.",
+        name="python_interpreter",
+        arguments="read_file(path='README.md')",
+        token_usage=SimpleNamespace(input_tokens=12, output_tokens=4),
+    )
+    child_call_id = trajectory.start_dispatch("read_file", {"path": "README.md"})
+    trajectory.finish_dispatch(child_call_id, "contents", is_error=False)
+    trajectory.finish_root_tool("contents", is_error=False)
+    trajectory.end_step()
+    trajectory.end_turn({"kind": "completed"})
+    trajectory.close()
+
+    saved = inspection(tmp_path)
+    assert [event["type"] for event in saved.events] == [
+        "turn/start",
+        "user/message",
+        "step/start",
+        "request/header",
+        "assistant/message",
+        "tool/call",
+        "tool/code-dispatch-start",
+        "tool/code-dispatch",
+        "tool/result",
+        "step/end",
+        "turn/end",
+    ]
+    assert [event["seq"] for event in saved.events] == list(range(11))
+    assistant = saved.events[4]["data"]["message"]
+    assert assistant["source"] == {
+        "kind": "model",
+        "provider": "test",
+        "model": "nexent-model",
+    }
+    assert assistant["content"][-1] == {
+        "type": "tool-call",
+        "id": root_call_id,
+        "name": "python_interpreter",
+        "arguments": "read_file(path='README.md')",
+    }
+    assert saved.events[6]["data"] == {
+        "rootCallId": root_call_id,
+        "parentCallId": root_call_id,
+        "subCallId": child_call_id,
+        "name": "read_file",
+        "arguments": {"path": "README.md"},
+    }
+    assert saved.events[7]["data"]["isError"] is False
+    assert saved.events[8]["sourceEventSeqs"] == [5]
+    reopened = EventTrajectory.open(config(tmp_path))
+    assert [message["role"] for message in reopened.session.derive_messages()] == [
+        "user",
+        "assistant",
+        "user",
+    ]
+    reopened.close()
