@@ -0,0 +1,341 @@
+"use client";
+
+import dynamic from "next/dynamic";
+import { useEffect, useMemo, useState, type ComponentType } from "react";
+import { useTranslation } from "react-i18next";
+import { useTheme } from "next-themes";
+import { AlertCircleIcon, GitForkIcon, RefreshCwIcon } from "lucide-react";
+import type {
+  SessionEvent,
+  SessionHeader,
+} from "@runfold/event/session/types";
+import type { EventTrajectoryProps } from "@runfold/trajectory-ui";
+import "@runfold/trajectory-ui/style.css";
+
+import { Button } from "@/components/ui/button";
+import {
+  conversationUrlForFork,
+  latestStableForkBoundary,
+  loadConversationTrajectory,
+  mergeConversationTrajectory,
+  trajectoryFailureStatus,
+  writeConversationView,
+} from "@/lib/conversationTrajectory";
+import { cn } from "@/lib/utils";
+import { ApiError } from "@/services/api";
+import { conversationService } from "@/services/conversationService";
+
+const EventTrajectory = dynamic<EventTrajectoryProps>(
+  () =>
+    import("@runfold/trajectory-ui").then(
+      (module) => module.EventTrajectory as ComponentType<EventTrajectoryProps>
+    ),
+  { ssr: false }
+);
+
+type LoadStatus =
+  "loading" | "ready" | "empty" | "missing" | "unavailable" | "error";
+
+interface TrajectoryState {
+  status: LoadStatus;
+  session?: SessionHeader;
+  events: SessionEvent[];
+  error?: string;
+}
+
+const initialState: TrajectoryState = {
+  status: "loading",
+  events: [],
+};
+
+const isAbortError = (error: unknown): boolean =>
+  error instanceof Error && error.name === "AbortError";
+
+const errorStatus = (error: unknown): LoadStatus => {
+  const code = error instanceof ApiError ? error.code : undefined;
+  return trajectoryFailureStatus(code);
+};
+
+const errorMessage = (error: unknown): string =>
+  error instanceof Error ? error.message : "Unknown trajectory error";
+
+const displaySessionId = (value: string): string =>
+  value.length > 28 ? `${value.slice(0, 16)}…${value.slice(-8)}` : value;
+
+export function ConversationTrajectoryPanel({
+  conversationId,
+  isRunning,
+}: {
+  conversationId: number;
+  isRunning: boolean;
+}) {
+  const { t, i18n } = useTranslation();
+  const { resolvedTheme } = useTheme();
+  const [reloadKey, setReloadKey] = useState(0);
+  const [state, setState] = useState<TrajectoryState>(initialState);
+  const [isForking, setIsForking] = useState(false);
+  const [forkError, setForkError] = useState<string>();
+
+  useEffect(() => {
+    const body = document.body;
+    const previous = body.getAttribute("data-ds-dark-theme");
+    if (resolvedTheme === "dark") body.setAttribute("data-ds-dark-theme", "");
+    else body.removeAttribute("data-ds-dark-theme");
+    return () => {
+      if (previous === null) body.removeAttribute("data-ds-dark-theme");
+      else body.setAttribute("data-ds-dark-theme", previous);
+    };
+  }, [resolvedTheme]);
+
+  useEffect(() => {
+    let stopped = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const controller = new AbortController();
+    let currentEvents: SessionEvent[] = [];
+    let currentSession: SessionHeader | undefined;
+    let nextSeq = 0;
+    let firstRequest = true;
+
+    const refresh = async () => {
+      if (firstRequest) setState(initialState);
+      try {
+        const update = await loadConversationTrajectory(
+          (fromSeq, limit) =>
+            conversationService.getTrajectory(conversationId, {
+              fromSeq,
+              limit,
+              signal: controller.signal,
+            }),
+          nextSeq
+        );
+        if (stopped) return;
+        if (currentSession && currentSession.id !== update.session.id) {
+          throw new Error("Trajectory Session changed while polling");
+        }
+        currentEvents =
+          nextSeq === 0
+            ? update.events
+            : mergeConversationTrajectory(currentEvents, update);
+        currentSession = update.session;
+        nextSeq = update.nextSeq;
+        setState({
+          status: currentEvents.length > 0 ? "ready" : "empty",
+          session: currentSession,
+          events: currentEvents,
+        });
+      } catch (error) {
+        if (stopped || isAbortError(error)) return;
+        if (currentSession) {
+          setState({
+            status: currentEvents.length > 0 ? "ready" : "empty",
+            session: currentSession,
+            events: currentEvents,
+            error: errorMessage(error),
+          });
+        } else {
+          setState({
+            status: errorStatus(error),
+            events: [],
+            error: errorMessage(error),
+          });
+        }
+      } finally {
+        firstRequest = false;
+        if (!stopped && isRunning) timer = setTimeout(refresh, 1000);
+      }
+    };
+
+    void refresh();
+    return () => {
+      stopped = true;
+      controller.abort();
+      if (timer) clearTimeout(timer);
+    };
+  }, [conversationId, isRunning, reloadKey]);
+
+  const stableBoundary = useMemo(
+    () => latestStableForkBoundary(state.events),
+    [state.events]
+  );
+
+  const forkTrajectory = async () => {
+    if (stableBoundary === undefined || isRunning || isForking) return;
+    setIsForking(true);
+    setForkError(undefined);
+    try {
+      const result = await conversationService.forkTrajectory(conversationId, {
+        boundary: stableBoundary,
+      });
+      const childId = Number(result.conversation.conversation_id);
+      if (!Number.isSafeInteger(childId) || childId <= 0) {
+        throw new Error("Fork response has no valid child conversation id");
+      }
+      try {
+        writeConversationView(window.localStorage, childId, "trajectory");
+      } catch {
+        // Navigation must still succeed when browser storage is unavailable.
+      }
+      window.location.assign(
+        conversationUrlForFork(window.location.href, childId)
+      );
+    } catch (error) {
+      setForkError(errorMessage(error));
+      setIsForking(false);
+    }
+  };
+
+  const locale = i18n.language.toLowerCase().startsWith("zh") ? "zh" : "en";
+  const session = state.session;
+
+  return (
+    <section
+      className="flex min-h-0 flex-1 flex-col bg-background"
+      aria-label={t("chatInterface.trajectory", "轨迹")}
+      data-testid="conversation-trajectory-panel"
+    >
+      <div className="flex min-h-10 items-center gap-3 border-b bg-muted/20 px-3 py-1.5 text-xs">
+        <div className="min-w-0 flex-1">
+          {session ? (
+            <div className="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1 text-muted-foreground">
+              <span className="min-w-0">
+                <span className="font-medium text-foreground">Session</span>{" "}
+                <span className="font-mono" title={String(session.id)}>
+                  {displaySessionId(String(session.id))}
+                </span>
+              </span>
+              {session.parentSession && (
+                <span>
+                  <span className="font-medium text-foreground">
+                    {t("chatInterface.trajectoryParent", "父 Session")}
+                  </span>{" "}
+                  <span
+                    className="font-mono"
+                    title={String(session.parentSession)}
+                  >
+                    {displaySessionId(String(session.parentSession))}
+                  </span>
+                </span>
+              )}
+              {session.seedLength !== undefined && (
+                <span>
+                  {t("chatInterface.trajectorySeedLength", "继承事件")}:{" "}
+                  {session.seedLength}
+                </span>
+              )}
+            </div>
+          ) : (
+            <span className="text-muted-foreground">
+              {t(
+                "chatInterface.trajectorySessionPending",
+                "正在读取 Event Session"
+              )}
+            </span>
+          )}
+        </div>
+        <Button
+          type="button"
+          variant="ghost"
+          size="sm"
+          className="h-7 gap-1.5 px-2"
+          onClick={() => setReloadKey((value) => value + 1)}
+          aria-label={t("common.refresh", "刷新")}
+        >
+          <RefreshCwIcon className="size-3.5" />
+          {t("common.refresh", "刷新")}
+        </Button>
+        <Button
+          type="button"
+          variant="outline"
+          size="sm"
+          className="h-7 gap-1.5 px-2"
+          disabled={stableBoundary === undefined || isRunning || isForking}
+          onClick={() => void forkTrajectory()}
+          title={
+            isRunning
+              ? t("chatInterface.trajectoryForkRunning", "运行结束后才能分叉")
+              : stableBoundary === undefined
+                ? t(
+                    "chatInterface.trajectoryForkUnavailable",
+                    "尚无已完成的 Turn 可供分叉"
+                  )
+                : `Event seq ${stableBoundary}`
+          }
+          data-testid="trajectory-fork"
+        >
+          <GitForkIcon className="size-3.5" />
+          {isForking
+            ? t("chatInterface.trajectoryForking", "分叉中…")
+            : t("chatInterface.trajectoryFork", "分叉")}
+        </Button>
+      </div>
+
+      {(state.error || forkError) &&
+        (state.status === "ready" || state.status === "empty") && (
+          <div className="flex items-center gap-2 border-b border-amber-200 bg-amber-50 px-3 py-1.5 text-xs text-amber-800">
+            <AlertCircleIcon className="size-3.5" />
+            {forkError || state.error}
+          </div>
+        )}
+
+      <div className="relative min-h-0 flex-1">
+        {state.status === "ready" && (
+          <EventTrajectory events={state.events} locale={locale} />
+        )}
+        {state.status !== "ready" && (
+          <div
+            className={cn(
+              "absolute inset-0 flex items-center justify-center px-6 text-center text-sm",
+              state.status === "error" || state.status === "unavailable"
+                ? "text-destructive"
+                : "text-muted-foreground"
+            )}
+            data-testid={`trajectory-state-${state.status}`}
+          >
+            <div className="max-w-lg space-y-2">
+              {state.status === "loading" && (
+                <p>{t("common.loading", "加载中…")}</p>
+              )}
+              {state.status === "empty" && (
+                <p>
+                  {t("chatInterface.trajectoryEmpty", "Event Session 暂无事件")}
+                </p>
+              )}
+              {state.status === "missing" && (
+                <p>
+                  {t(
+                    "chatInterface.trajectoryMissing",
+                    "该会话尚未生成 Event 轨迹"
+                  )}
+                </p>
+              )}
+              {state.status === "unavailable" && (
+                <p>
+                  {t(
+                    "chatInterface.trajectoryUnavailable",
+                    "Event 轨迹功能当前不可用"
+                  )}
+                </p>
+              )}
+              {state.status === "error" && (
+                <p>{t("chatInterface.trajectoryLoadFailed", "轨迹加载失败")}</p>
+              )}
+              {state.error && state.status !== "missing" && (
+                <p className="font-mono text-xs opacity-80">{state.error}</p>
+              )}
+              {(state.status === "error" || state.status === "unavailable") && (
+                <Button
+                  type="button"
+                  variant="outline"
+                  size="sm"
+                  onClick={() => setReloadKey((value) => value + 1)}
+                >
+                  {t("common.retry", "重试")}
+                </Button>
+              )}
+            </div>
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
