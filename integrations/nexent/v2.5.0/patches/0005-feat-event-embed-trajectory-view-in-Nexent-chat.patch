diff --git a/frontend/lib/conversationTrajectory.ts b/frontend/lib/conversationTrajectory.ts
index ff218b61f5a576cd45c7d594329ef375d58f13b3..074bf552b86cbbb79463bd84e7bcbb1fab9d963b 100644
--- a/frontend/lib/conversationTrajectory.ts
+++ b/frontend/lib/conversationTrajectory.ts
@@ -9,6 +9,7 @@ export const TRAJECTORY_PAGE_SIZE = 5000;
 export const TRAJECTORY_MAX_EVENTS = 1_000_000;
 
 export type ConversationView = "conversation" | "trajectory";
+export type TrajectoryFailureStatus = "missing" | "unavailable" | "error";
 
 export interface KeyValueStorage {
   getItem(key: string): string | null;
@@ -145,6 +146,25 @@ export function mergeConversationTrajectory(
   return [...current, ...update.events];
 }
 
+export function latestStableForkBoundary(
+  events: readonly SessionEvent[]
+): number | undefined {
+  for (let index = events.length - 1; index >= 0; index -= 1) {
+    const event = events[index];
+    if (event?.type === "turn/end") return event.seq;
+  }
+  return undefined;
+}
+
+export function trajectoryFailureStatus(
+  code: string | number | undefined
+): TrajectoryFailureStatus {
+  const numericCode = Number(code);
+  if (numericCode === 404) return "missing";
+  if (numericCode === 503) return "unavailable";
+  return "error";
+}
+
 const conversationViewStorageKey = (conversationId: number): string =>
   `nexent:conversation:${conversationId}:view`;
 
