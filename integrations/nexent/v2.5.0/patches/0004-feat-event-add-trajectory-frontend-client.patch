diff --git a/frontend/tests/conversationTrajectory.test.ts b/frontend/tests/conversationTrajectory.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3c3cebf596062a31e543f514d470e041f86162d6
--- /dev/null
+++ b/frontend/tests/conversationTrajectory.test.ts
@@ -0,0 +1,162 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import type {
+  SessionEvent,
+  SessionHeader,
+} from "@runfold/event/session/types";
+
+import {
+  ConversationTrajectoryProtocolError,
+  conversationUrlForFork,
+  loadConversationTrajectory,
+  mergeConversationTrajectory,
+  readConversationView,
+  writeConversationView,
+  // @ts-expect-error -- Node's built-in TypeScript runner needs the extension.
+} from "../lib/conversationTrajectory.ts";
+
+const header = (id = "session-1") =>
+  ({ version: 0, id, createdAt: 1 }) as SessionHeader;
+
+const event = (seq: number): SessionEvent =>
+  ({
+    type: "turn/start",
+    seq,
+    time: seq + 1,
+    data: { turn: seq + 1 },
+  }) as SessionEvent;
+
+test("loads a long trajectory through strict contiguous pages", async () => {
+  const events = Array.from({ length: 10_001 }, (_, seq) => event(seq));
+  const calls: Array<[number, number]> = [];
+  const result = await loadConversationTrajectory(async (fromSeq, limit) => {
+    calls.push([fromSeq, limit]);
+    const pageEvents = events.slice(fromSeq, fromSeq + limit);
+    const nextSeq = fromSeq + pageEvents.length;
+    return {
+      session: header(),
+      events: pageEvents,
+      from_seq: fromSeq,
+      next_seq: nextSeq,
+      has_more: nextSeq < events.length,
+      total_events: events.length,
+    };
+  });
+
+  assert.deepEqual(calls, [
+    [0, 5000],
+    [5000, 5000],
+    [10_000, 5000],
+  ]);
+  assert.equal(result.events.length, 10_001);
+  assert.equal(result.nextSeq, 10_001);
+  assert.equal(result.session.id, "session-1");
+});
+
+test("loads an empty but valid trajectory", async () => {
+  const result = await loadConversationTrajectory(async () => ({
+    session: header(),
+    events: [],
+    from_seq: 0,
+    next_seq: 0,
+    has_more: false,
+    total_events: 0,
+  }));
+
+  assert.deepEqual(result.events, []);
+  assert.equal(result.totalEvents, 0);
+});
+
+test("rejects malformed, stalled, or cross-Session pagination", async (t) => {
+  await t.test("wrong event sequence", async () => {
+    await assert.rejects(
+      loadConversationTrajectory(async () => ({
+        session: header(),
+        events: [event(2)],
+        from_seq: 0,
+        next_seq: 1,
+        has_more: false,
+        total_events: 1,
+      })),
+      ConversationTrajectoryProtocolError
+    );
+  });
+
+  await t.test("no pagination progress", async () => {
+    await assert.rejects(
+      loadConversationTrajectory(async () => ({
+        session: header(),
+        events: [],
+        from_seq: 0,
+        next_seq: 0,
+        has_more: true,
+        total_events: 1,
+      })),
+      /made no progress/
+    );
+  });
+
+  await t.test("Session changes", async () => {
+    let page = 0;
+    await assert.rejects(
+      loadConversationTrajectory(async (fromSeq) => {
+        page += 1;
+        return {
+          session: header(page === 1 ? "parent" : "other"),
+          events: [event(fromSeq)],
+          from_seq: fromSeq,
+          next_seq: fromSeq + 1,
+          has_more: page === 1,
+          total_events: 2,
+        };
+      }),
+      /Session changed/
+    );
+  });
+});
+
+test("merges only an exact live continuation", () => {
+  const current = [event(0), event(1)];
+  const update = {
+    session: header(),
+    events: [event(2), event(3)],
+    nextSeq: 4,
+    totalEvents: 4,
+  };
+  assert.deepEqual(
+    mergeConversationTrajectory(current, update).map((item) => item.seq),
+    [0, 1, 2, 3]
+  );
+  assert.throws(
+    () =>
+      mergeConversationTrajectory(current, {
+        ...update,
+        events: [event(3)],
+      }),
+    /does not continue/
+  );
+});
+
+test("persists the selected view per conversation", () => {
+  const values = new Map<string, string>();
+  const storage = {
+    getItem: (key: string) => values.get(key) ?? null,
+    setItem: (key: string, value: string) => values.set(key, value),
+  };
+
+  assert.equal(readConversationView(storage, 7), "conversation");
+  writeConversationView(storage, 7, "trajectory");
+  assert.equal(readConversationView(storage, 7), "trajectory");
+  assert.equal(readConversationView(storage, 8), "conversation");
+});
+
+test("builds a fork URL without losing locale or unrelated query state", () => {
+  assert.equal(
+    conversationUrlForFork(
+      "https://example.test/base/zh/newchat?thread_id=4&panel=open",
+      19
+    ),
+    "https://example.test/base/zh/newchat?panel=open&conversation_id=19"
+  );
+});
