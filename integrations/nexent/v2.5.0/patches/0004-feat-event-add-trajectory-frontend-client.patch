diff --git a/frontend/lib/conversationTrajectory.ts b/frontend/lib/conversationTrajectory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ff218b61f5a576cd45c7d594329ef375d58f13b3
--- /dev/null
+++ b/frontend/lib/conversationTrajectory.ts
@@ -0,0 +1,177 @@
+import type {
+  SessionEvent,
+  SessionHeader,
+} from "@runfold/event/session/types";
+
+import type { ConversationTrajectoryPage } from "../types/conversation";
+
+export const TRAJECTORY_PAGE_SIZE = 5000;
+export const TRAJECTORY_MAX_EVENTS = 1_000_000;
+
+export type ConversationView = "conversation" | "trajectory";
+
+export interface KeyValueStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+export interface LoadedConversationTrajectory {
+  session: SessionHeader;
+  events: SessionEvent[];
+  nextSeq: number;
+  totalEvents: number;
+}
+
+export type ConversationTrajectoryPageFetcher = (
+  fromSeq: number,
+  limit: number
+) => Promise<ConversationTrajectoryPage>;
+
+export class ConversationTrajectoryProtocolError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ConversationTrajectoryProtocolError";
+  }
+}
+
+const assertSafeInteger = (value: number, name: string): void => {
+  if (!Number.isSafeInteger(value) || value < 0) {
+    throw new ConversationTrajectoryProtocolError(
+      `${name} must be a non-negative safe integer`
+    );
+  }
+};
+
+const validatePage = (
+  page: ConversationTrajectoryPage,
+  expectedFromSeq: number,
+  expectedSessionId?: string
+): void => {
+  assertSafeInteger(page.from_seq, "from_seq");
+  assertSafeInteger(page.next_seq, "next_seq");
+  assertSafeInteger(page.total_events, "total_events");
+
+  if (page.from_seq !== expectedFromSeq) {
+    throw new ConversationTrajectoryProtocolError(
+      `trajectory page started at ${page.from_seq}, expected ${expectedFromSeq}`
+    );
+  }
+  if (page.next_seq !== page.from_seq + page.events.length) {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory next_seq does not match the returned event count"
+    );
+  }
+  if (page.total_events < page.next_seq) {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory total_events is smaller than next_seq"
+    );
+  }
+  if (page.has_more && page.events.length === 0) {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory pagination made no progress"
+    );
+  }
+  if (!page.has_more && page.next_seq !== page.total_events) {
+    throw new ConversationTrajectoryProtocolError(
+      "final trajectory page does not end at total_events"
+    );
+  }
+  if (!page.session || typeof page.session.id !== "string") {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory page has no valid Session header"
+    );
+  }
+  if (expectedSessionId && page.session.id !== expectedSessionId) {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory Session changed between pages"
+    );
+  }
+
+  page.events.forEach((event, index) => {
+    const expectedSeq = page.from_seq + index;
+    if (event.seq !== expectedSeq) {
+      throw new ConversationTrajectoryProtocolError(
+        `trajectory event seq ${event.seq} does not match ${expectedSeq}`
+      );
+    }
+  });
+};
+
+export async function loadConversationTrajectory(
+  fetchPage: ConversationTrajectoryPageFetcher,
+  fromSeq = 0
+): Promise<LoadedConversationTrajectory> {
+  assertSafeInteger(fromSeq, "fromSeq");
+
+  let cursor = fromSeq;
+  let session: SessionHeader | undefined;
+  let totalEvents = fromSeq;
+  const events: SessionEvent[] = [];
+
+  while (true) {
+    const page = await fetchPage(cursor, TRAJECTORY_PAGE_SIZE);
+    validatePage(page, cursor, session?.id);
+    session ??= page.session;
+    events.push(...page.events);
+    cursor = page.next_seq;
+    totalEvents = page.total_events;
+
+    if (cursor > TRAJECTORY_MAX_EVENTS) {
+      throw new ConversationTrajectoryProtocolError(
+        `trajectory exceeds ${TRAJECTORY_MAX_EVENTS} events`
+      );
+    }
+    if (!page.has_more) break;
+  }
+
+  if (!session) {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory request returned no Session header"
+    );
+  }
+  return { session, events, nextSeq: cursor, totalEvents };
+}
+
+export function mergeConversationTrajectory(
+  current: readonly SessionEvent[],
+  update: LoadedConversationTrajectory
+): SessionEvent[] {
+  if (update.events.length === 0) return [...current];
+  if (update.events[0]?.seq !== current.length) {
+    throw new ConversationTrajectoryProtocolError(
+      "trajectory update does not continue the current event sequence"
+    );
+  }
+  return [...current, ...update.events];
+}
+
+const conversationViewStorageKey = (conversationId: number): string =>
+  `nexent:conversation:${conversationId}:view`;
+
+export function readConversationView(
+  storage: KeyValueStorage,
+  conversationId: number
+): ConversationView {
+  return storage.getItem(conversationViewStorageKey(conversationId)) ===
+    "trajectory"
+    ? "trajectory"
+    : "conversation";
+}
+
+export function writeConversationView(
+  storage: KeyValueStorage,
+  conversationId: number,
+  view: ConversationView
+): void {
+  storage.setItem(conversationViewStorageKey(conversationId), view);
+}
+
+export function conversationUrlForFork(
+  currentHref: string,
+  conversationId: number
+): string {
+  const url = new URL(currentHref);
+  url.searchParams.delete("thread_id");
+  url.searchParams.set("conversation_id", String(conversationId));
+  return url.toString();
+}
