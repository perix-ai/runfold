+def test_fork_rejects_active_writer_and_open_turn_boundary(monkeypatch, tmp_path):
+    _enable(monkeypatch, tmp_path)
+    _authorize(monkeypatch)
+    config = _config()
+    trajectory = EventTrajectory.open(config)
+    trajectory.begin_turn("question")
+    open_boundary = trajectory.session.events[-1]["seq"]
+
+    with pytest.raises(service.EventTrajectoryConflictError):
+        service.fork_conversation_trajectory(
+            conversation_id=7,
+            user_id="user-a",
+            tenant_id="tenant-a",
+        )
+    trajectory.close()
+
+    clone = MagicMock()
+    monkeypatch.setattr(service, "_clone_conversation_prefix", clone)
+    with pytest.raises(service.EventTrajectoryBoundaryError, match="open turn"):
+        service.fork_conversation_trajectory(
+            conversation_id=7,
+            user_id="user-a",
+            tenant_id="tenant-a",
+            boundary=open_boundary,
+        )
+    clone.assert_not_called()
