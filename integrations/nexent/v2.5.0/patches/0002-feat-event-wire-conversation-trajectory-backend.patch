+def test_read_pages_a_long_live_trajectory_without_repair(monkeypatch, tmp_path):
+    _enable(monkeypatch, tmp_path)
+    _authorize(monkeypatch)
+    config = _config()
+    persistence = JsonlSessionPersistence(tmp_path, compression="none")
+    store = SessionStore(persistence)
+    session = store.create(config.session_id, meta={"cwd": config.cwd})
+    for index in range(20_000):
+        session.append("nexent/test", {"index": index}, ignorable=True)
+    store.flush(session)
+
+    page = service.read_conversation_trajectory(
+        conversation_id=7,
+        user_id="user-a",
+        tenant_id="tenant-a",
+        from_seq=19_990,
+        limit=7,
+    )
+    assert [event["seq"] for event in page["events"]] == list(range(19_990, 19_997))
+    assert page["next_seq"] == 19_997
+    assert page["total_events"] == 20_000
+    assert page["has_more"] is True
+    store.close()
+
