diff --git a/backend/services/event_trajectory_service.py b/backend/services/event_trajectory_service.py
new file mode 100644
index 0000000000000000000000000000000000000000..beb5e1f378c4be73fa5f2c626fc8078e29526e6f
--- /dev/null
+++ b/backend/services/event_trajectory_service.py
@@ -0,0 +1,453 @@
+"""Application boundary for Nexent-backed Runfold Event trajectories."""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+from consts import const as runtime_constants
+from consts.exceptions import ConversationNotFoundError
+from database.conversation_db import (
+    create_conversation_message,
+    create_message_unit,
+    create_source_image,
+    create_source_search,
+    delete_conversation,
+    get_conversation_history,
+)
+from nexent.core.agents import (
+    EventSessionLease,
+    EventTrajectoryAlreadyActiveError,
+    EventTrajectoryConfig,
+)
+from services.conversation_management_service import (
+    create_new_conversation,
+    get_conversation_service,
+)
+
+logger = logging.getLogger("event_trajectory_service")
+
+EVENT_TRAJECTORY_MAX_PAGE_SIZE = 5000
+_SESSION_ID_PREFIX = "nexent-v1"
+_LOGICAL_CWD_ROOT = "/nexent/event-workspaces"
+
+
+class EventTrajectoryServiceError(RuntimeError):
+    """Base class for errors exposed by the Event trajectory API."""
+
+
+class EventTrajectoryDisabledError(EventTrajectoryServiceError):
+    """Raised when no Event artifact root is configured."""
+
+
+class EventTrajectoryUnavailableError(EventTrajectoryServiceError):
+    """Raised when the optional Event implementation is unavailable or invalid."""
+
+
+class EventTrajectoryNotFoundError(EventTrajectoryServiceError):
+    """Raised when an authorized conversation has no materialized Event Session."""
+
+
+class EventTrajectoryConflictError(EventTrajectoryServiceError):
+    """Raised when a writer already owns the requested Event Session."""
+
+
+class EventTrajectoryBoundaryError(EventTrajectoryServiceError):
+    """Raised when a fork boundary is not a stable Event prefix."""
+
+
+def _identity_digest(tenant_id: str, user_id: str, conversation_id: int) -> str:
+    payload = f"{_SESSION_ID_PREFIX}\0{tenant_id}\0{user_id}\0{int(conversation_id)}"
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def _workspace_digest(tenant_id: str, user_id: str) -> str:
+    payload = f"{_SESSION_ID_PREFIX}\0{tenant_id}\0{user_id}"
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def event_trajectory_config_for_conversation(
+    tenant_id: str,
+    user_id: str,
+    conversation_id: int,
+) -> EventTrajectoryConfig | None:
+    """Return the stable, opaque Event identity for one owned conversation."""
+
+    root = runtime_constants.NEXENT_EVENT_TRAJECTORY_ROOT
+    if not root:
+        return None
+    root_path = Path(root)
+    if not root_path.is_absolute():
+        raise EventTrajectoryUnavailableError(
+            "NEXENT_EVENT_TRAJECTORY_ROOT must be an absolute path"
+        )
+    compression = runtime_constants.NEXENT_EVENT_TRAJECTORY_COMPRESSION
+    if compression not in {"none", "zstd"}:
+        raise EventTrajectoryUnavailableError(
+            "NEXENT_EVENT_TRAJECTORY_COMPRESSION must be none or zstd"
+        )
+    session_digest = _identity_digest(tenant_id, user_id, conversation_id)
+    workspace_digest = _workspace_digest(tenant_id, user_id)
+    return EventTrajectoryConfig(
+        root=str(root_path),
+        session_id=f"{_SESSION_ID_PREFIX}-{session_digest}",
+        cwd=f"{_LOGICAL_CWD_ROOT}/{workspace_digest}",
+        compression=compression,
+    )
+
+
+def event_trajectory_config_for_run(
+    *,
+    tenant_id: str,
+    user_id: str,
+    conversation_id: int | None,
+    is_debug: bool,
+) -> EventTrajectoryConfig | None:
+    """Enable Event recording only for persistent, non-debug conversations."""
+
+    if is_debug or conversation_id is None:
+        return None
+    return event_trajectory_config_for_conversation(
+        tenant_id=tenant_id,
+        user_id=user_id,
+        conversation_id=conversation_id,
+    )
+
+
+def _require_authorized_config(
+    conversation_id: int,
+    user_id: str,
+    tenant_id: str,
+) -> tuple[dict[str, Any], EventTrajectoryConfig]:
+    conversation = get_conversation_service(
+        conversation_id=conversation_id,
+        user_id=user_id,
+        tenant_id=tenant_id,
+    )
+    if conversation is None:
+        raise ConversationNotFoundError(
+            f"Conversation {conversation_id} does not exist or is not accessible"
+        )
+    config = event_trajectory_config_for_conversation(
+        tenant_id=tenant_id,
+        user_id=user_id,
+        conversation_id=conversation_id,
+    )
+    if config is None:
+        raise EventTrajectoryDisabledError("Event trajectory recording is not configured")
+    return conversation, config
+
+
+def _event_api() -> dict[str, Any]:
+    try:
+        from runfold.event import (
+            JsonlSessionPersistence,
+            SessionForkError,
+            SessionNotFoundError,
+            SessionStore,
+        )
+    except ImportError as exc:
+        raise EventTrajectoryUnavailableError(
+            "Event trajectory support requires the runfold-event package"
+        ) from exc
+    return {
+        "JsonlSessionPersistence": JsonlSessionPersistence,
+        "SessionForkError": SessionForkError,
+        "SessionNotFoundError": SessionNotFoundError,
+        "SessionStore": SessionStore,
+    }
+
+
+def read_conversation_trajectory(
+    *,
+    conversation_id: int,
+    user_id: str,
+    tenant_id: str,
+    from_seq: int = 0,
+    limit: int = 1000,
+) -> dict[str, Any]:
+    """Read one authorized Event page without attaching a live writer."""
+
+    if isinstance(from_seq, bool) or not isinstance(from_seq, int) or from_seq < 0:
+        raise ValueError("from_seq must be a non-negative integer")
+    if (
+        isinstance(limit, bool)
+        or not isinstance(limit, int)
+        or not 1 <= limit <= EVENT_TRAJECTORY_MAX_PAGE_SIZE
+    ):
+        raise ValueError(
+            f"limit must be between 1 and {EVENT_TRAJECTORY_MAX_PAGE_SIZE}"
+        )
+    _, config = _require_authorized_config(conversation_id, user_id, tenant_id)
+    api = _event_api()
+    persistence = api["JsonlSessionPersistence"](
+        config.root,
+        compression=config.compression,
+    )
+    try:
+        inspection = persistence.read_from(config.session_id, 0)
+    except api["SessionNotFoundError"] as exc:
+        raise EventTrajectoryNotFoundError(
+            f"Conversation {conversation_id} has no Event trajectory"
+        ) from exc
+
+    all_events = list(inspection.events)
+    page = all_events[from_seq:from_seq + limit]
+    next_seq = from_seq + len(page)
+    return {
+        "session": inspection.meta,
+        "events": page,
+        "from_seq": from_seq,
+        "next_seq": next_seq,
+        "has_more": next_seq < len(all_events),
+        "total_events": len(all_events),
+    }
+
+
+def _messages_for_turn_prefix(
+    messages: Iterable[dict[str, Any]], completed_turns: int
+) -> list[dict[str, Any]]:
+    selected: list[dict[str, Any]] = []
+    seen_turns = 0
+    for message in messages:
+        if message.get("role") == "user":
+            seen_turns += 1
+            if seen_turns > completed_turns:
+                break
+        if 0 < seen_turns <= completed_turns:
+            selected.append(message)
+    if completed_turns > seen_turns:
+        raise EventTrajectoryUnavailableError(
+            "Event trajectory contains more completed turns than the Nexent conversation"
+        )
+    return selected
+
+
+def _clone_conversation_prefix(
+    *,
+    parent: dict[str, Any],
+    conversation_id: int,
+    completed_turns: int,
+    user_id: str,
+    title: str | None,
+) -> dict[str, Any]:
+    history = get_conversation_history(conversation_id, user_id)
+    if history is None:
+        raise ConversationNotFoundError(
+            f"Conversation {conversation_id} does not exist or is not accessible"
+        )
+    selected = _messages_for_turn_prefix(history["message_records"], completed_turns)
+    parent_title = str(parent.get("conversation_title") or "New Conversation")
+    child_title = title.strip() if title else f"{parent_title[:92]} (fork)"
+    if not child_title:
+        raise EventTrajectoryUnavailableError("Forked conversation title must not be blank")
+    child = create_new_conversation(
+        child_title,
+        user_id,
+        agent_id=parent.get("agent_id"),
+        chat_mode=parent.get("chat_mode"),
+        knowledge_scope=parent.get("knowledge_scope"),
+        runtime_metadata=parent.get("runtime_metadata") or None,
+    )
+    child_id = int(child["conversation_id"])
+
+    message_id_map: dict[int, int] = {}
+    unit_id_map: dict[int, int] = {}
+    try:
+        for message in selected:
+            old_message_id = int(message["message_id"])
+            new_message_id = create_conversation_message(
+                {
+                    "conversation_id": child_id,
+                    "message_idx": int(message["message_index"]),
+                    "role": str(message["role"]),
+                    "content": message.get("message_content") or "",
+                    "minio_files": message.get("minio_files"),
+                },
+                user_id,
+                status=message.get("status") or "completed",
+            )
+            message_id_map[old_message_id] = new_message_id
+
+            units = [
+                unit
+                for unit in sorted(
+                    message.get("units") or [],
+                    key=lambda item: int(item.get("unit_index") or 0),
+                )
+                if unit.get("unit_type") != "history_summary"
+            ]
+            for unit in units:
+                new_unit_id = create_message_unit(
+                    message_id=new_message_id,
+                    conversation_id=child_id,
+                    unit_index=int(unit.get("unit_index") or 0),
+                    unit_type=unit.get("unit_type"),
+                    unit_content=unit.get("unit_content") or "",
+                    user_id=user_id,
+                    unit_status=unit.get("unit_status") or "completed",
+                    tool_call_id=unit.get("tool_call_id"),
+                    invocation_id=unit.get("invocation_id"),
+                )
+                if unit.get("unit_id") is not None:
+                    unit_id_map[int(unit["unit_id"])] = new_unit_id
+
+        for source in history["search_records"]:
+            old_message_id = int(source["message_id"])
+            if old_message_id not in message_id_map:
+                continue
+            old_unit_id = source.get("unit_id")
+            if old_unit_id is not None and int(old_unit_id) not in unit_id_map:
+                continue
+            create_source_search(
+                {
+                    "conversation_id": child_id,
+                    "message_id": message_id_map[old_message_id],
+                    "unit_id": unit_id_map.get(int(old_unit_id)) if old_unit_id is not None else None,
+                    "source_type": source.get("source_type") or "",
+                    "source_title": source.get("source_title") or "",
+                    "source_location": source.get("source_location") or "",
+                    "source_content": source.get("source_content") or "",
+                    "score_overall": source.get("score_overall"),
+                    "score_accuracy": source.get("score_accuracy"),
+                    "score_semantic": source.get("score_semantic"),
+                    "published_date": source.get("published_date"),
+                    "cite_index": source.get("cite_index"),
+                    "search_type": source.get("search_type"),
+                    "tool_sign": source.get("tool_sign") or "",
+                },
+                user_id=user_id,
+            )
+
+        for image in history["image_records"]:
+            old_message_id = int(image["message_id"])
+            if old_message_id not in message_id_map:
+                continue
+            create_source_image(
+                {
+                    "conversation_id": child_id,
+                    "message_id": message_id_map[old_message_id],
+                    "image_url": image["image_url"],
+                },
+                user_id=user_id,
+            )
+    except BaseException:
+        delete_conversation(child_id, user_id)
+        raise
+    return child
+
+
+def fork_conversation_trajectory(
+    *,
+    conversation_id: int,
+    user_id: str,
+    tenant_id: str,
+    boundary: int | None = None,
+    title: str | None = None,
+) -> dict[str, Any]:
+    """Fork an Event prefix and the matching Nexent conversation turns."""
+
+    parent, parent_config = _require_authorized_config(
+        conversation_id, user_id, tenant_id
+    )
+    api = _event_api()
+    try:
+        parent_lease = EventSessionLease(parent_config.root, parent_config.session_id)
+    except Exception as exc:
+        if isinstance(exc, EventTrajectoryAlreadyActiveError):
+            raise EventTrajectoryConflictError(str(exc)) from exc
+        raise
+
+    store = None
+    child_lease = None
+    child: dict[str, Any] | None = None
+    try:
+        persistence = api["JsonlSessionPersistence"](
+            parent_config.root,
+            compression=parent_config.compression,
+        )
+        store = api["SessionStore"](persistence)
+        try:
+            parent_session = store.resume(parent_config.session_id)
+        except api["SessionNotFoundError"] as exc:
+            raise EventTrajectoryNotFoundError(
+                f"Conversation {conversation_id} has no Event trajectory"
+            ) from exc
+
+        probe_store = api["SessionStore"]()
+        probe_parent = probe_store.create("parent", seed=parent_session.events)
+        try:
+            probe_child = probe_store.fork(
+                probe_parent,
+                boundary=boundary,
+                child_session_id="child",
+            )
+        except api["SessionForkError"] as exc:
+            raise EventTrajectoryBoundaryError(str(exc)) from exc
+        completed_turns = sum(
+            event["type"] == "turn/end" for event in probe_child.events
+        )
+
+        child = _clone_conversation_prefix(
+            parent=parent,
+            conversation_id=conversation_id,
+            completed_turns=completed_turns,
+            user_id=user_id,
+            title=title,
+        )
+        child_id = int(child["conversation_id"])
+        child_config = event_trajectory_config_for_conversation(
+            tenant_id=tenant_id,
+            user_id=user_id,
+            conversation_id=child_id,
+        )
+        assert child_config is not None
+        try:
+            child_lease = EventSessionLease(child_config.root, child_config.session_id)
+        except Exception as exc:
+            if isinstance(exc, EventTrajectoryAlreadyActiveError):
+                raise EventTrajectoryConflictError(str(exc)) from exc
+            raise
+        try:
+            child_session = store.fork(
+                parent_session,
+                boundary=boundary,
+                child_session_id=child_config.session_id,
+            )
+            store.flush(child_session)
+        except api["SessionForkError"] as exc:
+            raise EventTrajectoryBoundaryError(str(exc)) from exc
+        seed_length = int(child_session.header.get("seedLength", 0))
+        result = {
+            "parent_conversation_id": conversation_id,
+            "conversation": child,
+            "boundary": seed_length - 1 if seed_length else None,
+            "completed_turns": completed_turns,
+            "session": child_session.header,
+        }
+        store.close()
+        store = None
+        return result
+    except BaseException:
+        if child is not None:
+            try:
+                delete_conversation(int(child["conversation_id"]), user_id)
+            except Exception:
+                logger.exception(
+                    "Failed to roll back forked conversation %s",
+                    child.get("conversation_id"),
+                )
+        raise
+    finally:
+        try:
+            if store is not None:
+                store.close()
+        finally:
+            try:
+                if child_lease is not None:
+                    child_lease.close()
+            finally:
+                parent_lease.close()
