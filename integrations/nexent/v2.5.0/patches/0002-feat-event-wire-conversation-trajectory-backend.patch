+from services import event_trajectory_service as service
+
+
+def _enable(monkeypatch: pytest.MonkeyPatch, tmp_path) -> None:
+    monkeypatch.setattr(
+        service.runtime_constants,
+        "NEXENT_EVENT_TRAJECTORY_ROOT",
+        str(tmp_path),
+    )
+    monkeypatch.setattr(
+        service.runtime_constants,
+        "NEXENT_EVENT_TRAJECTORY_COMPRESSION",
+        "none",
+    )
+
+
+def _authorize(monkeypatch: pytest.MonkeyPatch, conversation_id: int = 7) -> None:
+    monkeypatch.setattr(
+        service,
+        "get_conversation_service",
+        lambda **_: {
+            "conversation_id": conversation_id,
+            "conversation_title": "Parent",
+            "agent_id": 3,
+            "chat_mode": "execution",
+            "knowledge_scope": None,
+            "runtime_metadata": {},
+        },
+    )
+
+
+def _config(conversation_id: int = 7) -> EventTrajectoryConfig:
+    config = service.event_trajectory_config_for_conversation(
+        tenant_id="tenant-a",
+        user_id="user-a",
+        conversation_id=conversation_id,
+    )
+    assert config is not None
+    return config
+
+
+def _record_completed_turn(config: EventTrajectoryConfig, text: str = "answer") -> None:
+    trajectory = EventTrajectory.open(config)
+    trajectory.begin_turn("question")
+    trajectory.begin_step(1)
+    trajectory.record_request(provider="test", model="model")
+    trajectory.record_assistant_text(text)
+    trajectory.end_step()
+    trajectory.end_turn({"kind": "completed"})
+    trajectory.close()
+
+
+def test_config_is_stable_opaque_and_fork_compatible(monkeypatch, tmp_path):
+    _enable(monkeypatch, tmp_path)
+
+    parent = _config(7)
+    same = _config(7)
+    child = _config(8)
+    other_user = service.event_trajectory_config_for_conversation(
+        "tenant-a", "user-b", 7
+    )
+
+    assert parent == same
+    assert parent.session_id != child.session_id
+    assert other_user is not None
+    assert parent.session_id != other_user.session_id
+    assert parent.cwd == child.cwd
+    assert parent.cwd != other_user.cwd
+    assert "tenant-a" not in parent.session_id
+    assert "user-a" not in parent.session_id
+
+
