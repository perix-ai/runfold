+export function stableForkBoundaries(
+  events: readonly SessionEvent[]
+): StableForkBoundary[] {
+  return events.flatMap((event) =>
+    event.type === "turn/end"
+      ? [{ turn: event.data.turn, boundary: event.seq }]
+      : []
+  );
+}
+
+export function stableForkBoundaryForTurn(
+  events: readonly SessionEvent[],
+  turn: number
+): number | undefined {
+  return stableForkBoundaries(events).find((item) => item.turn === turn)
+    ?.boundary;
+}
