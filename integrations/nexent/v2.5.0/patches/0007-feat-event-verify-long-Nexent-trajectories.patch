+def test_twenty_turn_cross_process_restore_fork_and_divergence(
+    tmp_path: Path,
+) -> None:
+    parent_id = "nexent-long-parent"
+    child_id = "nexent-long-fork"
+
+    first_phase = run_long_nexent_process(tmp_path, parent_id, 1, 10)
+    assert first_phase["turns"] == 10
+    first_prefix = list(inspection(tmp_path, parent_id).events)
+
+    second_phase = run_long_nexent_process(
+        tmp_path,
+        parent_id,
+        11,
+        10,
+        child_id,
+    )
+    assert second_phase["turns"] == 20
+    assert second_phase["steps"] == 20
+    assert second_phase["toolCalls"] == 5
+
+    parent_at_fork = inspection(tmp_path, parent_id)
+    parent_fork_events = list(parent_at_fork.events)
+    assert list(parent_fork_events[: len(first_prefix)]) == first_prefix
+    assert [event["seq"] for event in parent_fork_events] == list(
+        range(len(parent_fork_events))
+    )
+    assert [event["type"] for event in parent_fork_events].count("turn/start") == 20
+    assert [event["type"] for event in parent_fork_events].count("turn/end") == 20
+    assert [event["type"] for event in parent_fork_events].count("step/start") == 20
+    assert [event["type"] for event in parent_fork_events].count("step/end") == 20
+
+    child_at_fork = inspection(tmp_path, child_id)
+    assert child_at_fork.meta["parentSession"] == parent_id
+    assert child_at_fork.meta["seedLength"] == len(parent_fork_events)
+    assert child_at_fork.meta["cwd"] == str(tmp_path.resolve())
+    assert list(child_at_fork.events[: len(parent_fork_events)]) == parent_fork_events
+
+    run_real_nexent_process(tmp_path, parent_id, "answer:parent-21")
+    parent_after_resume = list(inspection(tmp_path, parent_id).events)
+    run_real_nexent_process(tmp_path, child_id, "child:fork-21")
+    child_after_resume = inspection(tmp_path, child_id)
+
+    assert parent_after_resume[: len(parent_fork_events)] == parent_fork_events
+    assert list(child_after_resume.events[: child_at_fork.meta["seedLength"]]) == (
+        parent_fork_events
+    )
+    assert [event["type"] for event in parent_after_resume].count("turn/end") == 21
+    assert [event["type"] for event in child_after_resume.events].count("turn/end") == 21
+    parent_last_user = [
+        event for event in parent_after_resume if event["type"] == "user/message"
+    ][-1]
+    child_last_user = [
+        event for event in child_after_resume.events if event["type"] == "user/message"
+    ][-1]
+    assert "parent-21" in parent_last_user["data"]["content"][0]["text"]
+    assert "fork-21" in child_last_user["data"]["content"][0]["text"]
+    assert list(inspection(tmp_path, parent_id).events) == parent_after_resume
+
