+def _run_long_event_worker(
+    root: Path,
+    session_id: str,
+    first_turn: int,
+    turn_count: int,
+    fork_child: str,
+) -> None:
+    if first_turn < 1 or turn_count < 1:
+        raise ValueError("first_turn and turn_count must be positive")
+    final_turn = first_turn + turn_count - 1
+    for turn in range(first_turn, final_turn + 1):
+        mode = "tool" if turn % 4 == 1 else "answer"
+        child = fork_child if turn == final_turn else "-"
+        _run_event_worker(root, session_id, f"{mode}:{turn:02d}", child)
+
+    saved = inspection(root, session_id)
+    event_types = [event["type"] for event in saved.events]
+    print(
+        "R38_RESULT="
+        + json.dumps(
+            {
+                "events": len(saved.events),
+                "turns": event_types.count("turn/end"),
+                "steps": event_types.count("step/end"),
+                "toolCalls": event_types.count("tool/call"),
+                "lastSeq": saved.events[-1]["seq"],
+            },
+            separators=(",", ":"),
+        )
     )
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 6 and sys.argv[1] == "--event-worker":
+        _run_event_worker(
+            Path(sys.argv[2]),
+            sys.argv[3],
+            sys.argv[4],
+            sys.argv[5],
+        )
+    elif len(sys.argv) == 7 and sys.argv[1] == "--long-event-worker":
+        _run_long_event_worker(
+            Path(sys.argv[2]),
+            sys.argv[3],
+            int(sys.argv[4]),
+            int(sys.argv[5]),
+            sys.argv[6],
+        )
