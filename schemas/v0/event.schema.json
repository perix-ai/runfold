{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Perix Runtime Data V0 Persisted Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace_id",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "schema_version",
    "recorded_at",
    "payload"
  ],
  "properties": {
    "namespace_id": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "stream_id": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/sequence"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "causation_event_id": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "payload": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  }
}
