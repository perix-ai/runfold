{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runfold:event:v0:session-header",
  "title": "Runfold Event Session Header v0",
  "type": "object",
  "required": ["version", "id", "createdAt"],
  "properties": {
    "version": { "const": 0 },
    "id": { "type": "string" },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cwd": { "type": "string" },
    "parentSession": { "type": "string" },
    "seedLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin": { "const": "subagent" },
    "delegationDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "agentPreset": { "type": "string" }
  }
}
