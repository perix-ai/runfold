{
  "name": "perix-runtime-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/event/typescript/trajectory-demo",
    "packages/event/typescript/sdk",
    "packages/event/typescript/ui/trajectory"
  ],
  "scripts": {
    "build": "npm run build --workspace @perix/event-sdk && npm run build --workspace @perix/event-ui && npm run build --workspace @perix/event-trajectory-demo",
    "verify:upstream-identity": "node scripts/verify-upstream-identity.mjs",
    "test": "npm run test:upstream && npm run test:types && npm run test:runtime && npm run test:sdk && npm run test:ui && npm run test:python && npm run test:system && npm run test:conformance",
    "test:upstream": "npm run test:upstream:event && npm run test:upstream:trajectory",
    "test:upstream:event": "vitest run --config vitest.config.ts packages/event/typescript/packages/core/session/tests packages/event/typescript/packages/session/session-persistence/tests packages/event/typescript/packages/session/session-persistence-jsonl/tests",
    "test:upstream:trajectory": "vitest run --config vitest.config.ts --environment jsdom packages/event/typescript/packages/client/ui-trajectory/tests",
    "test:types": "tsc -p packages/event/typescript/tsconfig.tests.json",
    "test:runtime": "vitest run --config vitest.config.ts packages/event/typescript/tests/runtime",
    "test:sdk": "vitest run --config vitest.config.ts packages/event/typescript/tests/sdk",
    "test:ui": "vitest run --config vitest.config.ts --environment jsdom packages/event/typescript/tests/ui",
    "test:system": "vitest run --config vitest.config.ts --environment jsdom packages/event/typescript/tests/integration",
    "test:conformance": "vitest run --config vitest.config.ts --environment jsdom tests/event/cross-language",
    "test:package": "node packages/event/typescript/tests/package/package-consumer.mjs",
    "test:python": "python3 -m unittest discover -s packages/event/python/tests -t packages/event/python -v",
    "test:python:package": "python3 packages/event/python/tests/package_consumer.py",
    "verify": "npm run verify:upstream-identity && npm run build && npm test && npm run test:package && npm run test:python:package",
    "dev:event-ui": "npm run dev --workspace @perix/event-trajectory-demo"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-compaction": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-deque": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm-retry": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tool-todo": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-crypto": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "0.1.2-alpha.3",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
